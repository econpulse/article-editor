{% extends "_common/base_article.html.j2" %}

{% block page_title %}{{ article.metadata.title }} — LUKB Investment Office (Tufte-Stil){% endblock %}

{% block extra_css %}
    :root {
      --shell-max-width: 1040px;
      --quote-accent: var(--lukb-gold);
    }

    .lukb-title {
      margin: 0 0 1.5em 0;
    }

    .lukb-lead {
      margin: 0 0 1.8em 0;
    }

    /* ========================================================================
       Tufte-Layout im Body:
       Entkoppelte Randspalte (float: right; clear: right), sodass der
       linke Haupttext ohne weisse Lücken neben hohen Randgrafiken weiterfliesst.
       ======================================================================== */
    .lukb-body {
      padding: 34px 44px;
      max-width: 980px;
      margin: 0 auto;
    }

    .lukb-body::after {
      content: "";
      display: table;
      clear: both;
    }

    /* Fliesstext, Überschriften, Callouts und Textboxen in die Hauptlesespalte (links) */
    .blk-h1,
    .blk-h2,
    .blk-h3,
    .blk-richtext,
    .blk-callout,
    .blk-richtext-textbox:not(.blk-full-span),
    .blk-quote:not(.blk-full-span) {
      width: calc(64.5% - 20px);
    }

    /* Einspaltige Grafiken und Tabellen im Randbereich (rechts, gestapelt ohne Textlücken) */
    .blk-figure:not(.blk-full-span),
    .blk-table-wrap:not(.blk-full-span) {
      float: right;
      clear: right;
      width: calc(35.5% - 16px);
      margin: 0 0 1.1rem 36px;
      padding: 10px 0 8px 0;
    }

    .blk-figure:not(.blk-full-span) .blk-box-title,
    .blk-table-wrap:not(.blk-full-span) .blk-box-title {
      font-size: 0.88rem;
      margin-bottom: 4px;
    }

    .blk-figure:not(.blk-full-span) .blk-box-subtitle,
    .blk-table-wrap:not(.blk-full-span) .blk-box-subtitle {
      font-size: 0.76rem;
      margin-bottom: 6px;
    }

    .blk-table-wrap:not(.blk-full-span) .lukb-data-table th,
    .blk-table-wrap:not(.blk-full-span) .lukb-data-table td {
      padding: 4px 6px;
      font-size: 0.76rem;
    }

    /* Zweispaltige Elemente spannen über die gesamte Breite */
    .blk-full-span,
    .blk-footnotes,
    .blk-glossary,
    .blk-publications,
    .blk-divider,
    .blk-spacer {
      clear: both;
      width: 100%;
    }

    h1.blk-h1 {
      margin-top: 1.6em;
    }

    h2.blk-h2 {
      margin-top: 1.5em;
    }

    h3.blk-h3 {
      margin-top: 1.4em;
    }

    .blk-richtext p {
      margin: 0 0 1.4em 0;
    }

    .blk-richtext-textbox {
      padding: 14px 16px;
      margin: 0 0 1.4em 0;
    }

    .blk-richtext-textbox.blk-full-span {
      clear: both;
      width: 100%;
    }

    .blk-richtext-textbox-grid::after {
      content: "";
      display: table;
      clear: both;
    }

    @media (max-width: 860px) {
      .lukb-article-shell {
        margin: 0;
        border-radius: 0;
        border-top-width: 4px;
      }
      .lukb-body {
        padding: 24px 20px;
      }
      .lukb-header {
        padding: 24px 20px;
      }
      .lukb-title {
        font-size: 1.65rem;
      }
      .blk-figure:not(.blk-full-span),
      .blk-table-wrap:not(.blk-full-span),
      .blk-full-span,
      .blk-h1, .blk-h2, .blk-h3, .blk-richtext, .blk-callout, .blk-richtext-textbox, .blk-quote {
        float: none !important;
        clear: both !important;
        width: 100% !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
      }
    }
{% endblock %}

{% block body_content %}
  {% for blk in article.blocks %}
    {% if blk.type == "textbox_group" %}
      {% set visual_children = [] %}
      {% set text_children = [] %}
      {% for child in blk.children %}
        {% if child.type in ["figure", "db_chart", "table"] %}
          {% set _ = visual_children.append(child) %}
        {% else %}
          {% set _ = text_children.append(child) %}
        {% endif %}
      {% endfor %}
      {% set has_visuals = visual_children | length > 0 %}
      {% set is_split = has_visuals and (text_children | length > 0) %}
      <div class="blk-richtext-textbox {% if has_visuals or blk.layout == 'full' %}blk-full-span{% endif %}">
        {% if is_split %}
          <div class="blk-richtext-textbox-grid">
            {% for child in blk.children %}
              {{ render_single_block(child, in_box=true) }}
            {% endfor %}
          </div>
        {% else %}
          {% for child in blk.children %}
            {{ render_single_block(child, in_box=true) }}
          {% endfor %}
        {% endif %}
      </div>
    {% else %}
      {{ render_single_block(blk, in_box=false) }}
    {% endif %}
  {% endfor %}
{% endblock %}
