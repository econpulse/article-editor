# ============================================================================
# LUKB Investment Office - Article-Editor Konfiguration
# ============================================================================

# Option 1: Vollständige SQLAlchemy Connection-URL (Überschreibt Einzelparameter)
# Beispiel MSSQL (pyodbc):
# DATABASE_URL=mssql+pyodbc://user:password@lukb-sql-server.internal:1433/InvestmentOfficeCMS?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# Beispiel MSSQL mit Windows Integrated Auth (Trusted Connection):
# DATABASE_URL=mssql+pyodbc://@lukb-sql-server.internal:1433/InvestmentOfficeCMS?driver=ODBC+Driver+18+for+SQL+Server&Trusted_Connection=yes&TrustServerCertificate=yes

# Option 2: Einzelne MSSQL-Umgebungsvariablen (Empfohlen für Posit Connect)
MSSQL_SERVER=
MSSQL_PORT=1433
MSSQL_DATABASE=InvestmentOfficeCMS
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_ENCRYPT=no
MSSQL_TRUST_SERVER_CERTIFICATE=yes
MSSQL_TRUSTED_CONNECTION=no

# Entwicklungs-Fallback (nur aktiv, wenn weder DATABASE_URL noch MSSQL_SERVER gesetzt ist)
LOCAL_FALLBACK_SQLITE_PATH=data/local_dev_cms.db

# Corporate Typography Konfiguration
LUKB_FONT_LIGHT=Yoga Sans for LUKB Light
LUKB_FONT_MEDIUM=Yoga Sans for LUKB Medium
LUKB_FONT_FAMILY_BASE=Yoga Sans for LUKB
